<mvc:View
  controllerName="ojt.booking.controller.Book"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core">
  <Page
    id="bookPage"
    class="ojtPage"
    showHeader="false"
    title="{= ${view>/reschedule} ? ${i18n>moveTitle} : ${i18n>bookTitle} }"
    busy="{view>/busy}"
    busyIndicatorDelay="0">
    <content>
      <HBox alignItems="Center" class="ojtPageNav">
        <Button
          icon="sap-icon://nav-back"
          text="{i18n>back}"
          tooltip="{i18n>back}"
          press=".onNavBack"
          class="ojtBackButton" />
        <Title text="{= ${view>/reschedule} ? ${i18n>moveTitle} : ${i18n>bookTitle} }" titleStyle="H4" level="H1" class="ojtPageTitle" />
      </HBox>
      <VBox id="itemHeader" class="ojtItemHeader">
        <Title text="{title}" titleStyle="H3" wrapping="true" class="ojtItemTitle" />
        <HBox wrap="Wrap" class="ojtItemFacts">
          <HBox alignItems="Center" class="ojtChip">
            <core:Icon src="sap-icon://fob-watch" class="ojtChipIcon" />
            <Text text="{ path: 'durationMinutes', formatter: '.durationText' }" />
          </HBox>
          <HBox alignItems="Center" class="ojtChip">
            <core:Icon src="sap-icon://map-2" class="ojtChipIcon" />
            <Text text="{location}" />
          </HBox>
          <HBox alignItems="Center" class="ojtChip">
            <core:Icon src="sap-icon://calendar" class="ojtChipIcon" />
            <Text text="{ path: 'dueDate', targetType: 'any', formatter: '.dueText' }" />
          </HBox>
        </HBox>
      </VBox>

      <MessageStrip
        id="rescheduleStrip"
        visible="{view>/reschedule}"
        text="{view>/rescheduleText}"
        type="Information"
        showIcon="true"
        class="ojtStrip" />
      <MessageStrip
        id="errorStrip"
        visible="{= !!${view>/error} }"
        text="{view>/error}"
        type="Warning"
        showIcon="true"
        showCloseButton="true"
        close=".onErrorClose"
        class="ojtStrip" />

      <VBox class="ojtPlanner">
        <HBox justifyContent="SpaceBetween" alignItems="End" wrap="Wrap" class="ojtPlannerBar">
          <VBox class="ojtObserverPick">
            <Label text="{i18n>observer}" labelFor="observerSelect" />
            <Select
              id="observerSelect"
              width="100%"
              forceSelection="true"
              selectedKey="{view>/observerId}"
              change=".onObserverChange"
              items="{ path: 'view>/observers', templateShareable: false }">
              <core:Item key="{view>ID}" text="{view>name}" />
            </Select>
          </VBox>

          <HBox alignItems="Center" class="ojtWeekNav">
            <Button
              id="prevWeek"
              icon="sap-icon://navigation-left-arrow"
              tooltip="{i18n>prevWeek}"
              enabled="{= ${view>/week/index} > 0 }"
              press=".onPrevWeek" />
            <VBox alignItems="Center" class="ojtWeekLabel">
              <Title id="weekTitle" text="{view>/week/title}" titleStyle="H4" />
              <Text text="{view>/week/range}" class="ojtWeekRange" />
              <Text text="{view>/week/counter}" class="ojtWeekCounter" />
            </VBox>
            <Button
              id="nextWeek"
              icon="sap-icon://navigation-right-arrow"
              tooltip="{i18n>nextWeek}"
              enabled="{= ${view>/week/index} &lt; ${view>/week/count} - 1 }"
              press=".onNextWeek" />
          </HBox>
        </HBox>

        <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="ojtWeekInfo">
          <Text text="{view>/week/summary}" />
          <Link
            text="{view>/week/nextFreeText}"
            visible="{= !!${view>/week/nextFreeText} }"
            press=".onJumpToNextFree" />
        </HBox>

        <HBox
          id="weekGrid"
          renderType="Bare"
          class="ojtWeek"
          items="{ path: 'view>/week/days', templateShareable: false }">
          <VBox class="ojtDay">
            <customData>
              <core:CustomData key="state" value="{view>state}" writeToDom="true" />
            </customData>
            <VBox class="ojtDayHead">
              <Text text="{view>weekday}" class="ojtDayName" />
              <Text text="{view>date}" class="ojtDayDate" />
            </VBox>
            <HBox
              renderType="Bare"
              class="ojtDaySlots"
              items="{ path: 'view>slots', templateShareable: false }">
              <Button
                text="{view>label}"
                tooltip="{view>tooltip}"
                type="{= ${view>startAt} === ${view>/selectedSlot/startAt} &amp;&amp; ${view>observerId} === ${view>/selectedSlot/observerId} ? 'Emphasized' : 'Default' }"
                press=".onSlotPress"
                class="ojtSlot" />
            </HBox>
            <Text text="{i18n>noTimes}" visible="{= ${view>slots}.length === 0 }" class="ojtDayEmpty" />
          </VBox>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
