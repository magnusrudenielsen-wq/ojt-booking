<mvc:View
  controllerName="ojt.booking.controller.Observations"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:grid="sap.ui.layout.cssgrid">
  <Page id="observationsPage" showHeader="false" class="ojtPage">
    <content>
      <VBox id="hero" class="ojtHero">
        <Title text="{i18n>observationsTitle}" titleStyle="H2" wrapping="true" class="ojtHeroTitle" />
        <Text text="{i18n>observationsInfo}" class="ojtHeroText" />
      </VBox>

      <IconTabBar
        id="tabs"
        class="ojtTabs"
        headerMode="Inline"
        expandable="false"
        applyContentPadding="false"
        backgroundDesign="Transparent"
        headerBackgroundDesign="Transparent"
        selectedKey="{obs>/tab}"
        select=".onTabSelect">
        <items>
          <IconTabFilter key="open" text="{i18n>tabOpen}" count="{obs>/openCount}" />
          <IconTabFilter key="completed" text="{i18n>tabCompleted}" count="{obs>/completedCount}" />
        </items>
      </IconTabBar>

      <f:GridList
        id="list"
        class="ojtGrid"
        busy="{obs>/busy}"
        busyIndicatorDelay="0"
        items="{
          path: 'obs>/items',
          sorter: [
            { path: 'statusOrder', group: '.groupByStatus' },
            { path: 'dueDate' }
          ],
          filters: [{ path: 'status', operator: 'NE', value1: 'Completed' }]
        }">
        <f:customLayout>
          <grid:GridBoxLayout boxMinWidth="19rem" />
        </f:customLayout>
        <f:noData>
          <IllustratedMessage
            illustrationType="sapIllus-NoActivities"
            title="{= ${obs>/tab} === 'completed' ? ${i18n>noCompletedTitle} : ${i18n>noObservationsTitle} }"
            description="{= ${obs>/tab} === 'completed' ? ${i18n>noCompleted} : ${i18n>noObservations} }" />
        </f:noData>
        <CustomListItem
          type="{= ${obs>status} === 'Completed' ? 'Inactive' : 'Active' }"
          press=".onItemPress"
          class="ojtCardItem">
          <VBox class="ojtCard" height="100%" justifyContent="SpaceBetween">
            <customData>
              <core:CustomData key="status" value="{obs>status}" writeToDom="true" />
            </customData>
            <VBox>
              <HBox justifyContent="SpaceBetween" alignItems="Center">
                <Avatar
                  src="{ path: 'obs>status', formatter: '.statusIcon' }"
                  displaySize="S"
                  displayShape="Square"
                  backgroundColor="{ path: 'obs>status', formatter: '.statusAvatarColor' }"
                  decorative="true" />
                <ObjectStatus
                  text="{ path: 'obs>status', formatter: '.statusText' }"
                  state="{ path: 'obs>status', formatter: '.statusState' }"
                  inverted="true" />
              </HBox>
              <Title text="{obs>title}" wrapping="true" class="ojtCardTitle" />
              <Text text="{obs>itemId}" class="ojtCardId" />

              <VBox class="ojtFacts">
                <HBox alignItems="Center" class="ojtFact" visible="{= ${obs>status} !== 'Completed' }">
                  <core:Icon src="sap-icon://calendar" class="ojtFactIcon" />
                  <Text text="{ parts: ['obs>dueDate', 'obs>status'], formatter: '.dueText' }" />
                </HBox>
                <HBox alignItems="Center" class="ojtFact">
                  <core:Icon src="sap-icon://fob-watch" class="ojtFactIcon" />
                  <Text text="{ path: 'obs>durationMinutes', formatter: '.durationText' }" />
                </HBox>
                <HBox alignItems="Center" class="ojtFact">
                  <core:Icon src="sap-icon://map-2" class="ojtFactIcon" />
                  <Text text="{obs>location}" />
                </HBox>
              </VBox>

              <Text
                class="ojtCardNote"
                text="{ parts: ['obs>status', 'obs>appointmentStart', 'obs>appointmentEnd', 'obs>observerName', 'obs>completedOn'], formatter: '.statusLine' }"
                visible="{= ${obs>status} !== 'ToBook' }" />
            </VBox>

            <Button
              text="{= ${obs>status} === 'ToBook' ? ${i18n>ctaBook} : ${i18n>ctaView} }"
              type="{= ${obs>status} === 'ToBook' ? 'Emphasized' : 'Default' }"
              visible="{= ${obs>status} !== 'Completed' }"
              width="100%"
              press=".onItemPress"
              class="ojtCardButton" />
          </VBox>
        </CustomListItem>
      </f:GridList>
    </content>
  </Page>
</mvc:View>
