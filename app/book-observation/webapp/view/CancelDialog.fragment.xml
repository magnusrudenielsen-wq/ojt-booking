<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    id="cancelDialog"
    title="{i18n>cancelTitle}"
    type="Message"
    state="Warning"
    busy="{view>/saving}"
    busyIndicatorDelay="0">
    <content>
      <VBox>
        <Text text="{view>/cancelText}" class="sapUiSmallMarginBottom" />
        <Label text="{i18n>reason}" labelFor="reasonSelect" />
        <Select id="reasonSelect" width="100%" selectedKey="{view>/reason}">
          <core:Item key="{i18n>reasonShift}" text="{i18n>reasonShift}" />
          <core:Item key="{i18n>reasonSick}" text="{i18n>reasonSick}" />
          <core:Item key="{i18n>reasonObserver}" text="{i18n>reasonObserver}" />
          <core:Item key="{i18n>reasonOther}" text="{i18n>reasonOther}" />
        </Select>
      </VBox>
    </content>
    <beginButton>
      <Button id="confirmCancelButton" text="{i18n>cancelBooking}" type="Reject" press=".onConfirmCancel" />
    </beginButton>
    <endButton>
      <Button text="{i18n>keepBooking}" press=".onCloseCancel" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
