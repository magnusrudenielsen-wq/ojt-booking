<mvc:View
  controllerName="ojt.availability.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified"
  displayBlock="true"
  height="100%">
  <App id="app">
    <Page id="page" showHeader="false" title="{i18n>pageTitle}" class="ojtPage">
      <content>
        <VBox id="hero" class="ojtHero">
          <Title text="{i18n>pageTitle}" titleStyle="H2" wrapping="true" class="ojtHeroTitle" />
          <Text text="{view>/greeting}" class="ojtHeroText" />
        </VBox>

        <IconTabBar
          id="tabs"
          class="ojtTabs"
          headerMode="Inline"
          expandable="false"
          applyContentPadding="false"
          backgroundDesign="Transparent"
          headerBackgroundDesign="Transparent">
          <items>

            <IconTabFilter key="calendar" text="{i18n>tabCalendar}">
              <VBox class="ojtPanel ojtCalendarPanel">
                <HBox alignItems="Center" class="ojtCalendarHint">
                  <core:Icon src="sap-icon://touch" class="ojtCalendarHintIcon" />
                  <Text text="{i18n>dragHint}" />
                </HBox>
                <SinglePlanningCalendar
                  id="calendar"
                  title="{i18n>calendarTitle}"
                  calendarWeekNumbering="ISO_8601"
                  startHour="6"
                  endHour="20"
                  fullDay="false"
                  startDate="{view>/startDate}"
                  startDateChange=".onStartDateChange"
                  viewChange=".onStartDateChange"
                  appointmentSelect=".onAppointmentSelect"
                  enableAppointmentsCreate="true"
                  appointmentCreate=".onCalendarDrag"
                  legend="legend"
                  appointments="{ path: 'view>/entries', templateShareable: false }">
                  <actions>
                    <Button text="{i18n>addAvailability}" icon="sap-icon://add" press=".onAddRule" />
                    <Button text="{i18n>blockTime}" icon="sap-icon://locked" press=".onAddBlock" />
                  </actions>
                  <views>
                    <SinglePlanningCalendarWorkWeekView key="WorkWeek" title="{i18n>workWeek}" />
                    <SinglePlanningCalendarWeekView key="Week" title="{i18n>week}" />
                    <SinglePlanningCalendarDayView key="Day" title="{i18n>day}" />
                  </views>
                  <appointments>
                    <u:CalendarAppointment
                      title="{view>title}"
                      text="{view>text}"
                      icon="{view>icon}"
                      color="{view>color}"
                      startDate="{view>start}"
                      endDate="{view>end}" />
                  </appointments>
                </SinglePlanningCalendar>
                <PlanningCalendarLegend id="legend" appointmentItemsHeader="" class="ojtLegend">
                  <appointmentItems>
                    <u:CalendarLegendItem text="{i18n>legendOpen}" color="#5DC122" />
                    <u:CalendarLegendItem text="{i18n>legendBooked}" color="#0070F2" />
                    <u:CalendarLegendItem text="{i18n>legendBlocked}" color="#E76500" />
                  </appointmentItems>
                </PlanningCalendarLegend>
              </VBox>
            </IconTabFilter>

            <IconTabFilter key="bookings" text="{i18n>tabBookings}" count="{view>/counts/bookings}">
              <VBox class="ojtPanel">
                <VBox class="ojtPanelHead">
                  <Title text="{i18n>bookingsTitle}" titleStyle="H5" class="ojtPanelTitle" />
                  <Text text="{i18n>bookingsInfo}" class="ojtPanelInfo" />
                </VBox>
                <Table
                  id="bookingsTable"
                  class="ojtTable"
                  backgroundDesign="Transparent"
                  noDataText="{i18n>noBookings}"
                  updateFinished=".onListUpdated"
                  items="{
                    path: '/MyAppointments',
                    filters: [{ path: 'status', operator: 'EQ', value1: 'Booked' }],
                    sorter: { path: 'startAt' }
                  }">
                  <customData>
                    <core:CustomData key="count" value="bookings" />
                  </customData>
                  <columns>
                    <Column><Text text="{i18n>when}" /></Column>
                    <Column><Text text="{i18n>employee}" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>observation}" /></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>where}" /></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>note}" /></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <Text text="{ parts: [{ path: 'startAt', targetType: 'any' }, { path: 'endAt', targetType: 'any' }], formatter: '.formatter.timeRange' }" class="ojtStrong" />
                        <Text text="{employeeName}" />
                        <Text text="{itemTitle}" />
                        <Text text="{location}" />
                        <Text text="{note}" />
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </VBox>
            </IconTabFilter>

          </items>
        </IconTabBar>
      </content>
    </Page>
  </App>
</mvc:View>
